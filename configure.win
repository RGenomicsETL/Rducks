#!/bin/sh
# Windows configure script for Rducks.
set -eu

THIS_DIR=`dirname "$0"`
THIS_DIR=`cd "$THIS_DIR" && pwd`
EXT_SRC_DIR="${THIS_DIR}/tools/ext"
EXT_INSTALL_DIR="${THIS_DIR}/inst/rducks_extension"
DUCKDB_CAPI_DIR="${EXT_SRC_DIR}/duckdb_capi"
DUCKDB_HEADERS_JSON="${DUCKDB_CAPI_DIR}/duckdb_headers.json"
SRC_FILE="${EXT_SRC_DIR}/rducks_extension.c"
BUILD_DIR="${EXT_INSTALL_DIR}/build"
VENDOR_DIR="${EXT_SRC_DIR}/third_party"
VENDOR_NNG_DIR="${VENDOR_DIR}/nng"
VENDOR_MBEDTLS_DIR="${VENDOR_DIR}/mbedtls"

if [ ! -f "${SRC_FILE}" ]; then
  echo "ERROR: Rducks extension source not found at ${SRC_FILE}"
  exit 1
fi
if [ ! -f "${DUCKDB_CAPI_DIR}/duckdb_extension.h" ] || [ ! -f "${DUCKDB_CAPI_DIR}/duckdb.h" ] || [ ! -f "${DUCKDB_HEADERS_JSON}" ]; then
  echo "ERROR: vendored DuckDB headers are incomplete under ${DUCKDB_CAPI_DIR}"
  exit 1
fi

# The vendored header release is the stable C extension API version that the
# extension targets. DuckDB loads a C_STRUCT extension on any engine that
# supports this API version, so it is also the minimum engine version.
DUCKDB_CAPI_VERSION=`awk -F'"' '/"duckdb_ref"/ {print $4; exit}' "${DUCKDB_HEADERS_JSON}" 2>/dev/null || true`
if ! printf '%s\n' "${DUCKDB_CAPI_VERSION}" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "ERROR: ${DUCKDB_HEADERS_JSON} records an invalid duckdb_ref '${DUCKDB_CAPI_VERSION}'"
  exit 1
fi
CAPI_VERSION_PARTS=`printf '%s\n' "${DUCKDB_CAPI_VERSION}" | sed -e 's/^v//' -e 's/\./ /g'`
set -- ${CAPI_VERSION_PARTS}
CAPI_CPPFLAGS="-DDUCKDB_EXTENSION_API_VERSION_MAJOR=$1 -DDUCKDB_EXTENSION_API_VERSION_MINOR=$2 -DDUCKDB_EXTENSION_API_VERSION_PATCH=$3"

CC=`"${R_HOME}/bin/R" CMD config CC | cut -f1 -d' '`
R_CPPFLAGS=`"${R_HOME}/bin/R" CMD config CPPFLAGS`
R_INCLUDE_FLAGS=`"${R_HOME}/bin/R" CMD config --cppflags`
R_CFLAGS=`"${R_HOME}/bin/R" CMD config CFLAGS`
R_CPICFLAGS=`"${R_HOME}/bin/R" CMD config CPICFLAGS`
R_LDFLAGS=`"${R_HOME}/bin/R" CMD config LDFLAGS`
R_LD_FLAGS=`"${R_HOME}/bin/R" CMD config --ldflags`
case " ${R_CPPFLAGS} ${R_INCLUDE_FLAGS} ${R_CFLAGS} ${R_CPICFLAGS} " in
  *DUCKDB_EXTENSION_API_VERSION_UNSTABLE*)
    echo "ERROR: Rducks builds against the stable DuckDB C extension API;"
    echo "remove DUCKDB_EXTENSION_API_VERSION_UNSTABLE from the compiler flags."
    exit 1
    ;;
esac

EXT_VERSION=`awk -F': *' '/^Version:/ {print $2; exit}' "${THIS_DIR}/DESCRIPTION" || true`
if [ -z "${EXT_VERSION}" ]; then
  EXT_VERSION="0.0.0"
fi

# The shell can run under x64 emulation on an ARM64 Windows host. The R
# installation and its compiler target—not uname—determine the extension ABI.
R_ARCH_NAME=`"${R_HOME}/bin/Rscript" -e 'cat(R.version$arch)'`
DUCKDB_PLATFORM=""
case "${R_ARCH_NAME}" in
  x86_64|amd64) DUCKDB_PLATFORM="windows_amd64_mingw";;
  aarch64|arm64) DUCKDB_PLATFORM="windows_arm64_mingw";;
esac
if [ -z "${DUCKDB_PLATFORM}" ]; then
  echo "ERROR: Unsupported Windows R architecture: ${R_ARCH_NAME}"
  exit 1
fi

rm -rf "${BUILD_DIR}"
mkdir -p "${BUILD_DIR}"

if [ ! -f "${VENDOR_DIR}/CMakeLists.txt" ] || [ ! -f "${VENDOR_NNG_DIR}/include/nng/nng.h" ] || \
   [ ! -f "${VENDOR_MBEDTLS_DIR}/include/mbedtls/version.h" ]; then
  echo "ERROR: vendored NNG/Mbed TLS sources are missing. Run tools/vendor_nng_mbedtls.R."
  exit 1
fi

RDUCKS_CMAKE="${CMAKE:-}"
if [ -n "${RDUCKS_CMAKE}" ]; then
  case "${RDUCKS_CMAKE}" in
    */*)
      if [ ! -x "${RDUCKS_CMAKE}" ]; then
        echo "ERROR: CMAKE points to a non-executable path: ${RDUCKS_CMAKE}"
        exit 1
      fi
      ;;
    *)
      if ! command -v "${RDUCKS_CMAKE}" >/dev/null 2>&1; then
        echo "ERROR: CMAKE is set but not executable on PATH: ${RDUCKS_CMAKE}"
        exit 1
      fi
      RDUCKS_CMAKE=`command -v "${RDUCKS_CMAKE}"`
      ;;
  esac
elif command -v cmake >/dev/null 2>&1; then
  RDUCKS_CMAKE=`command -v cmake`
else
  echo "ERROR: cmake is required to build the vendored NNG library"
  echo "Set CMAKE=/path/to/cmake if cmake is installed outside PATH."
  exit 1
fi

# CRAN limits installation to two CPU cores; RDUCKS_BUILD_JOBS overrides this
# for local builds.
RDUCKS_BUILD_JOBS="${RDUCKS_BUILD_JOBS:-2}"
case "${RDUCKS_BUILD_JOBS}" in
  ""|*[!0-9]*|0|0[0-9]*)
    echo "ERROR: RDUCKS_BUILD_JOBS must be a positive integer, got: ${RDUCKS_BUILD_JOBS}"
    exit 1
    ;;
esac

VENDOR_BUILD_DIR="${BUILD_DIR}/vendor_nng"
"${RDUCKS_CMAKE}" -S "${VENDOR_DIR}" -B "${VENDOR_BUILD_DIR}" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER="${CC}"
"${RDUCKS_CMAKE}" --build "${VENDOR_BUILD_DIR}" --target nng --parallel "${RDUCKS_BUILD_JOBS}"
VENDOR_NNG_CPPFLAGS="-DNNG_STATIC_LIB -I${VENDOR_NNG_DIR}/include"
VENDOR_NNG_LIBS="${VENDOR_BUILD_DIR}/nng/libnng.a -lws2_32 -lmswsock -ladvapi32"

CFLAGS="${R_CFLAGS} ${R_CPICFLAGS} -O2"
BASE_CPPFLAGS="${R_CPPFLAGS} ${R_INCLUDE_FLAGS} -DNDEBUG -DDUCKDB_EXTENSION_NAME=rducks -I${THIS_DIR}/src ${VENDOR_NNG_CPPFLAGS}"
# Disable MinGW automatic exports while retaining DuckDB's explicit
# __declspec(dllexport) entrypoint. LLVM's MinGW linker on Windows ARM64 does
# not support --exclude-libs; it is redundant once automatic exports are off.
SHARED_FLAGS="-shared -Wl,--exclude-all-symbols"

SIGN_DIR="${EXT_SRC_DIR}/sign"
SIGN_BIN="${BUILD_DIR}/rducks_sign.exe"
MBEDTLS_SIGN_SOURCES=""
for mbedtls_source in aes asn1parse asn1write base64 bignum bignum_core constant_time ctr_drbg \
  entropy entropy_poll md oid pk pk_wrap pkparse pkwrite platform platform_util rsa rsa_alt_helpers sha256; do
  MBEDTLS_SIGN_SOURCES="${MBEDTLS_SIGN_SOURCES} ${VENDOR_MBEDTLS_DIR}/library/${mbedtls_source}.c"
done

RAW_EXT_FILE="${BUILD_DIR}/rducks.duckdb_extension.raw"
UNSIGNED_EXT_FILE="${BUILD_DIR}/rducks.duckdb_extension.unsigned"
FINAL_EXT_FILE="${BUILD_DIR}/rducks.duckdb_extension"
PUBLIC_KEY_FILE="${BUILD_DIR}/rducks.pub"
CPPFLAGS="${BASE_CPPFLAGS} ${CAPI_CPPFLAGS} -I${DUCKDB_CAPI_DIR}"

echo "---------- Building Rducks DuckDB extension (Windows) ----------"
echo "DuckDB stable C extension API: ${DUCKDB_CAPI_VERSION}"
echo "DuckDB platform: ${DUCKDB_PLATFORM}"
echo "Vendored NNG support: 1"
echo "CMake: ${RDUCKS_CMAKE}"
${CC} ${SHARED_FLAGS} ${CFLAGS} ${CPPFLAGS} ${R_LDFLAGS} -o "${RAW_EXT_FILE}" "${SRC_FILE}" ${VENDOR_NNG_LIBS} ${R_LD_FLAGS}

echo "Appending DuckDB extension metadata..."
"${R_HOME}/bin/Rscript" "${THIS_DIR}/tools/append_extension_metadata.R" \
  --library-file "${RAW_EXT_FILE}" \
  --out-file "${UNSIGNED_EXT_FILE}" \
  --extension-name "rducks" \
  --duckdb-platform "${DUCKDB_PLATFORM}" \
  --duckdb-version "${DUCKDB_CAPI_VERSION}" \
  --extension-version "${EXT_VERSION}" \
  --abi-type "C_STRUCT"

echo "Signing the extension with a key generated for this installation..."
${CC} ${R_CFLAGS} -I"${SIGN_DIR}" -I"${VENDOR_MBEDTLS_DIR}/include" -I"${VENDOR_MBEDTLS_DIR}/library" \
  '-DMBEDTLS_CONFIG_FILE="rducks_sign_config.h"' -o "${SIGN_BIN}" \
  "${SIGN_DIR}/rducks_sign.c" ${MBEDTLS_SIGN_SOURCES} -lbcrypt
"${SIGN_BIN}" "${UNSIGNED_EXT_FILE}" "${FINAL_EXT_FILE}" "${PUBLIC_KEY_FILE}"
rm -f "${RAW_EXT_FILE}" "${UNSIGNED_EXT_FILE}" "${SIGN_BIN}"
rm -rf "${VENDOR_BUILD_DIR}"
echo "Built ${FINAL_EXT_FILE}"
