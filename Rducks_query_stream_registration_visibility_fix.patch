diff -ruN Rducks/inst/tinytest/test_query_stream.R Rducks_fixed/inst/tinytest/test_query_stream.R
--- Rducks/inst/tinytest/test_query_stream.R	2026-05-13 12:52:32.000000000 +0000
+++ Rducks_fixed/inst/tinytest/test_query_stream.R	2026-05-13 21:52:06.085500834 +0000
@@ -117,3 +117,53 @@
   expect_true(stream$is_closed())
   expect_error(stream$next_batch(), "closed")
 })
+
+local({
+  con <- DBI::dbConnect(duckdb::duckdb(config = list(allow_unsigned_extensions = "true")), dbdir = ":memory:")
+  on.exit({
+    try(rducks_release(con), silent = TRUE)
+    DBI::dbDisconnect(con, shutdown = TRUE)
+  }, add = TRUE)
+  rducks_enable(con, threads = "single")
+
+  stream <- rducks_query_stream(con, "SELECT i::INTEGER AS i FROM range(1, 6) t(i)", batch_size = 2L)
+  expect_equal(stream$next_batch()$i, 1:2)
+  expect_equal(stream$next_batch()$i, 3:4)
+  expect_true(isTRUE(stream$close()))
+
+  reg_scalar <- rducks_register_scalar_udf(
+    con,
+    "r_after_stream_plus_one",
+    function(x) x + 1,
+    DOUBLE,
+    DOUBLE
+  )
+  expect_inherits(reg_scalar, "rducks_scalar_udf_registration")
+  expect_equal(DBI::dbGetQuery(con, "SELECT r_after_stream_plus_one(1.0) AS x")$x, 2)
+
+  reg_table <- rducks_register_table(
+    con,
+    "r_after_stream_table",
+    function() data.frame(i = 1:3),
+    chunk_size = 2L
+  )
+  expect_inherits(reg_table, "rducks_table_registration")
+  expect_equal(DBI::dbGetQuery(con, "SELECT sum(i) AS s FROM r_after_stream_table()")$s, 6)
+
+  pack <- function(x) serialize(x, NULL, version = 2)
+  unpack <- function(state) if (is.null(state)) 0L else unserialize(state)
+  reg_agg <- rducks_register_aggregate(
+    con,
+    "r_after_stream_sum_i32",
+    update = function(state, x) pack(as.integer(unpack(state) + x)),
+    finalize = function(state) as.integer(unpack(state)),
+    INTEGER,
+    INTEGER,
+    combine = function(left, right) pack(as.integer(unpack(left) + unpack(right)))
+  )
+  expect_inherits(reg_agg, "rducks_aggregate_registration")
+  expect_equal(
+    DBI::dbGetQuery(con, "SELECT r_after_stream_sum_i32(i) AS s FROM (VALUES (1::INTEGER), (2::INTEGER), (3::INTEGER)) t(i)")$s,
+    6L
+  )
+})
