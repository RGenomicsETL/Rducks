 #include <thread>
 
 // Avoid clash with TRUE and FALSE macros in older rtools
@@ -25,6 +28,46 @@ bool duckdb::OnRThread() {
 	return std::this_thread::get_id() == r_thread;
 }
 
+void duckdb::RequireRApiThread(const char *operation) {
+	if (!OnRThread()) {
+		throw InvalidInputException("%s requires R's recorded thread; R-backed inputs are unsupported in a native "
+		                            "query driver",
+		                            operation);
+	}
+}
+
+// A native query driver (a package that runs queries on its own thread while R's
+// thread keeps running) brackets that work with enter/exit. The count is
+// process-wide and changes no database setting.
+static std::atomic<uint32_t> native_drivers {0};
+
+// C-callable capability, uint32_t(void). Version 3: off-thread guards on the
+// R-backed scans, and the native driver enter/exit marker.
+static uint32_t OffMainGuardVersion() {
+	return 3;
+}
+
+static void NativeDriverEnter() noexcept {
+	native_drivers.fetch_add(1);
+}
+
+static void NativeDriverExit() noexcept {
+	native_drivers.fetch_sub(1);
+}
+
+bool duckdb::NativeDriverActive() {
+	return native_drivers.load() > 0;
+}
+
+void duckdb::RegisterNativeDriverCallables() {
+	cpp11::safe[R_RegisterCCallable](DUCKDB_PACKAGE_NAME, "duckdb_r_off_main_guard_version",
+	                                reinterpret_cast<DL_FUNC>(OffMainGuardVersion));
+	cpp11::safe[R_RegisterCCallable](DUCKDB_PACKAGE_NAME, "duckdb_r_native_driver_enter",
+	                                reinterpret_cast<DL_FUNC>(NativeDriverEnter));
+	cpp11::safe[R_RegisterCCallable](DUCKDB_PACKAGE_NAME, "duckdb_r_native_driver_exit",
+	                                reinterpret_cast<DL_FUNC>(NativeDriverExit));
+}
+
 [[cpp11::register]] SEXP rapi_adbc_init_func() {
 	return R_MakeExternalPtrFn((DL_FUNC)duckdb_adbc_init, R_NilValue, R_NilValue);
 }
