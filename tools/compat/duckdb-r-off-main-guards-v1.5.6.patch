diff --git a/src/utils.cpp b/src/utils.cpp
index 597194f..db7ac0d 100644
--- a/src/utils.cpp
+++ b/src/utils.cpp
@@ -6,12 +6,45 @@
 #include "rapi.hpp"
 #include "typesr.hpp"
 
+#include <R_ext/Rdynload.h>
+#include <cstdint>
+#include <mutex>
+#include <thread>
+
 // Avoid clash with TRUE and FALSE macros in older rtools
 #undef TRUE
 #undef FALSE
 
 using namespace duckdb;
 
+static std::once_flag r_api_thread_once;
+static std::thread::id r_api_thread;
+static std::atomic<bool> r_api_thread_initialized {false};
+
+// C-callable capability, uint32_t(void), registered after database startup.
+// Version 1 guards R-backed binding, replacement scans and Arrow factories.
+static uint32_t OffMainGuardVersion() {
+	return 1;
+}
+
+void InitializeRApiThread() {
+	std::call_once(r_api_thread_once, [] {
+		r_api_thread = std::this_thread::get_id();
+		r_api_thread_initialized.store(true, std::memory_order_release);
+	});
+	RequireRApiThread("database startup");
+	cpp11::safe[R_RegisterCCallable](DUCKDB_PACKAGE_NAME, "duckdb_r_off_main_guard_version",
+	                                reinterpret_cast<DL_FUNC>(OffMainGuardVersion));
+}
+
+void RequireRApiThread(const char *operation) {
+	if (!r_api_thread_initialized.load(std::memory_order_acquire) ||
+	    std::this_thread::get_id() != r_api_thread) {
+		throw InvalidInputException("%s requires R's recorded thread; R-backed inputs are unsupported in a native "
+		                            "query driver", operation);
+	}
+}
+
 [[cpp11::register]] SEXP rapi_adbc_init_func() {
 	return R_MakeExternalPtrFn((DL_FUNC)duckdb_adbc_init, R_NilValue, R_NilValue);
