+static SEXP rducks_r_aggregate_subset_vector(SEXP values, const idx_t *rows, idx_t row_count,
+                                             idx_t full_count, int *protect_count,
+                                             char *err, size_t err_cap) {
+    int identity = row_count == full_count;
+    if (identity) {
+        for (idx_t i = 0; i < row_count; i++) {
+            if (rows[i] != i) {
+                identity = 0;
+                break;
+            }
+        }
+    }
+    if (identity) return values;
+    if (row_count > (idx_t)INT_MAX) {
+        snprintf(err, err_cap, "Rducks aggregate vectorized update group is too large for R indexing");
+        return R_NilValue;
+    }
+    SEXP idx = PROTECT(Rf_allocVector(INTSXP, (R_xlen_t)row_count));
+    for (idx_t i = 0; i < row_count; i++) {
+        if (rows[i] >= (idx_t)INT_MAX) {
+            UNPROTECT(1);
+            snprintf(err, err_cap, "Rducks aggregate row index is too large for R indexing");
+            return R_NilValue;
+        }
+        INTEGER(idx)[(R_xlen_t)i] = (int)rows[i] + 1;
+    }
+    SEXP call = PROTECT(Rf_lang3(Rf_install("["), values, idx));
+    int r_err = 0;
+    SEXP out = PROTECT(R_tryEvalSilent(call, R_GlobalEnv, &r_err));
+    UNPROTECT(2); /* idx, call */
+    if (r_err) {
+        UNPROTECT(1); /* out */
+        snprintf(err, err_cap, "Rducks aggregate vectorized update failed while subsetting input vectors");
+        return R_NilValue;
+    }
+    (*protect_count)++;
+    return out;
+}
