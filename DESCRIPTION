RoxygenNote: 7.3.3
Depends:
    R (>= 4.1)
Imports:
    DBI,
    duckdb (>= 1.5.0),
    methods,
    nanoarrow,
    S7
LinkingTo:
    nanoarrow
Suggests:
    tinytest
